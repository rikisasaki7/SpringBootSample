<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- 設定値 -->
  <property name="charset" value="UTF-8" />
  <property name="format" value="aaaaaaaaa %d{yyyy-MM-dd HH:mm:ss} %-5level [%thread] - %msg%n" />
  <!-- <property name="file.path" value="./sample-local.log" />
  <property name="file.path.pattern" value="${file.path}-%d{yyyy-MM-dd}.log" /> -->

  <!-- springPropertyを使うと、application.ymlから値を取得できる。profileに沿った値を設定可能になる -->
  <springProperty name="file.path" source="log.file.path" />
  <springProperty name="file.path.pattern" source="log.file.pattern" />

  <!--profile毎のログレベル -->
  <springProfile name="local">
    <property name="log.level" value="DEBUG" />
    <property name="log.level.hibernatre" value="TRACE" />
  </springProfile>
  <springProfile name="dev">
    <property name="log.level" value="INFO" />
    <property name="log.level.hibernatre" value="INFO" />
  </springProfile>


  <!-- コンソール出力 -->
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.out</target>
    <!-- 出力される文字列に関する箇所-->
    <encoder>
      <charset>${charset}</charset>
      <pattern>${format}</pattern>
    </encoder>
  </appender>

  <!-- ファイル出力 -->
  <appender name="APP_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <!-- 出力先 -->
    <file>${file.path}</file>
    <!-- ローリングポリシー -->
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${file.path.pattern}</fileNamePattern>
      <maxHistory>3</maxHistory>
    </rollingPolicy>
    <!-- 出力される文字列に関する箇所-->
    <encoder>
      <pattern>${format}</pattern>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="STDOUT" />
    <appender-ref ref="APP_LOG" />
  </root>

<!-- ログ出力レベルの設定 -->
<logger name="com.example.demo" level="${log.level}" />
<logger name="org.hibernate.SQL" level="${log.level}" />
<logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="${log.level.hibernate}" />
<logger name="org.hibernate.type.EnumType" level="${log.level.hibernate}" />

</configuration>